# Copy to .env.local for local development with `vercel dev`.
# In production these go in Vercel → Settings → Environment Variables.

# Required for the AI layer (guides for apps that aren't curated yet, and the chat).
# The curated guides work fine without it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-sonnet-5.
# ANTHROPIC_MODEL=claude-sonnet-5

# Optional. How many web searches Claude may run per request. Defaults to 5.
# MAX_WEB_SEARCHES=5
